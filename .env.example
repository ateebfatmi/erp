# ==============================================================================
# ENTERPRISE SCHOOL ERP - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Base
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=platformdomain.com
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Clerk Authentication
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/portal
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL & Storage
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. Razorpay Payments & Subscriptions
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 4. Communication Gateways (Transactional)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="VidyaERP <notifications@platformdomain.com>"
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key

# ------------------------------------------------------------------------------
# 5. Background Jobs (Inngest)
# ------------------------------------------------------------------------------
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# ------------------------------------------------------------------------------
# 6. Observability & Telemetry
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=https://your_sentry_dsn
